[Unit]
Description=Claude Code remote-control (claude rc) in a tmux session on the default socket
Requires=tmux-server.service
After=tmux-server.service

[Service]
# Just ensure the session exists on the default tmux socket; the tmux window
# runs a while-loop that respawns claude rc on crash, so systemd does not need
# to track the process. KillMode=none + a targeted ExecStop mean stopping this
# unit only kills the claude-rc session, never the user's other tmux sessions.
Type=oneshot
RemainAfterExit=yes
KillMode=none
# Without this, an OOM-kill of any process in the cgroup marks the whole unit
# failed even though the session is fine.
OOMPolicy=continue
# No WorkingDirectory= on purpose: it would make the unit fail with a CHDIR
# error on any host lacking that directory. The session's directory is set by
# the launcher (CLAUDE_RC_WORKDIR, falling back to $HOME).
ExecStart=%h/.local/bin/start-claude-rc.sh
ExecStop=-/bin/sh -c 'tmux kill-session -t claude-rc'

[Install]
WantedBy=default.target
